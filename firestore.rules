rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      }

      // Medications subcollection
      match /medications/{medId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(medId);
      }

      // Weights subcollection
      match /weights/{weightId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(weightId);
      }

      // Settings subcollection
      match /settings/{docId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      // Tab notes subcollection
      match /tab_notes/{noteId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }

      // Daily journal / diary subcollection
      match /journal/{entryId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }

      // Habit tracker subcollection
      match /habits/{habitId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(habitId);
      }
    }
  }
}
